import json
import spacy
from spacy.tokens import DocBin
from sklearn.model_selection import train_test_split
from spacy.training import Example
import random
import os

DATA_URL = "https://raw.githubusercontent.com/mlsa-iai-msu-lab/cl-ruterm3/master/cl-ruterm3-sample.json"
DATA_FILE = "cl-ruterm3-sample.json"

def load_data_from_github():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
        print("Данные из локального файла")
        return data
    try:
        import requests
        r = requests.get(DATA_URL, timeout=20)
        r.raise_for_status()
        data = r.json()
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        print("Данные загружены с GitHub и сохранены локально")
        return data
    except Exception as e:
        print("Ошибка загрузки данных:", e)
        return None

def convert_to_spacy_format(data_items, text_key="text", labels_key="label", spans_key="sc"):
    # Используем пустую русскую модель для токенизации
    nlp = spacy.blank("ru")
    doc_bin = DocBin()
    skipped_annotations = 0
    total_annotations = 0

    for idx, item in enumerate(data_items):
        text = item[text_key]
        annotations = item[labels_key]

        doc = nlp.make_doc(text)
        spans = []

        for ann in annotations:
            total_annotations += 1
            start, end, label = ann
            span = doc.char_span(start, end, label=label, alignment_mode="contract")
            if span is not None:
                spans.append(span)
            else:
                skipped_annotations += 1
                print(f"Документ {idx}: Не удалось создать span для '{text[start:end]}' ({start}:{end})")

        try:
            if spans:
                # Записываем спаны под ключом spans_key
                doc.spans[spans_key] = spans
            doc_bin.add(doc)
        except Exception as e:
            print(f"Ошибка при добавлении документа {idx}: {e}")

    print(f"\n=== Статистика конвертации ===")
    print(f"Всего аннотаций: {total_annotations}, пропущено при сохранении в DocBin: {skipped_annotations}")

    return doc_bin

def train_with_transfer_learning(train_data, test_data, n_iter=50, desired_spans_key=None):
    # Попытаемся загрузить базовую модель
    try:
        nlp = spacy.load("ru_core_news_md")
        print("Загружена модель 'ru_core_news_md' для transfer learning.")
    except OSError:
        print("Модель 'ru_core_news_md' не найдена — используем пустую модель 'ru'.")
        nlp = spacy.blank("ru")

    # Если модель уже содержит spancat, возьмём из неё spans_key, иначе используем желаемый (или 'sc' по умолчанию)
    existing_spancat_key = None
    if "spancat" in nlp.pipe_names:
        sp = nlp.get_pipe("spancat")
        existing_spancat_key = getattr(sp, "cfg", {}).get("spans_key", None)

    spans_key = existing_spancat_key or desired_spans_key or "sc"
    print(f"Используем spans_key='{spans_key}' для spancat")

    # Убедимся, что есть tok2vec или transformer
    if "tok2vec" not in nlp.pipe_names and "transformer" not in nlp.pipe_names:
        nlp.add_pipe("tok2vec", first=True)

    # Если spancat отсутствует — добавим его с нужным spans_key.
    # Важно: не передаём недопустимые ключи в config (например, allow_overlap), иначе confection выбросит ошибку.
    if "spancat" not in nlp.pipe_names:
        nlp.add_pipe("spancat", last=True, config={"spans_key": spans_key})
        spancat = nlp.get_pipe("spancat")
        # Устанавливаем allow_overlap программно, если атрибут доступен
        try:
            setattr(spancat, "allow_overlap", True)
        except Exception:
            # Если установить нельзя — просто продолжаем; модель всё равно может выдавать перекрытия в doc.spans
            pass
    else:
        spancat = nlp.get_pipe("spancat")
        cfg_key = getattr(spancat, "cfg", {}).get("spans_key", None)
        if cfg_key and cfg_key != spans_key:
            print(f"Внимание: существующий spancat использует spans_key='{cfg_key}', а мы ожидали '{spans_key}'. Будем использовать существующий ('{cfg_key}').")
            spans_key = cfg_key
        # Попробуем включить allow_overlap, если есть атрибут
        try:
            setattr(spancat, "allow_overlap", True)
        except Exception:
            pass

    spancat = nlp.get_pipe("spancat")

    # Собираем все метки из train_data
    labels = set()
    for item in train_data:
        for start, end, label in item["label"]:
            labels.add(label)
    for label in sorted(labels):
        try:
            spancat.add_label(label)
        except Exception:
            pass

    # Подготовка Examples: gold = {"spans": {spans_key: [(start,end,label), ...]}}
    train_examples = []
    skipped_examples = 0
    for idx, item in enumerate(train_data):
        text = item["text"]
        annotations = item["label"]

        doc = nlp.make_doc(text)
        spans_list = []
        for start, end, label in annotations:
            spans_list.append((start, end, label))

        if not spans_list:
            skipped_examples += 1
            continue

        gold = {"spans": {spans_key: spans_list}}
        try:
            example = Example.from_dict(doc, gold)
            train_examples.append(example)
        except Exception as e:
            skipped_examples += 1
            print(f"Не удалось создать Example для текста (длина {len(text)}): {e}")

    print(f"Создано {len(train_examples)} обучающих примеров для spancat, пропущено {skipped_examples}.")
    if not train_examples:
        raise SystemExit("Нет валидных обучающих примеров для spancat. Проверьте формат аннотаций.")

    # Инициализируем с generator returning iterable of Examples
    nlp.initialize(lambda: (ex for ex in train_examples))

    print("Начинаем дообучение spancat...")
    other_pipes = [pipe for pipe in nlp.pipe_names if pipe != "spancat"]
    with nlp.disable_pipes(*other_pipes):
        optimizer = nlp.resume_training()
        for iteration in range(n_iter):
            random.shuffle(train_examples)
            losses = {}
            batches = spacy.util.minibatch(train_examples, size=8)
            for batch in batches:
                nlp.update(batch, drop=0.3, losses=losses, sgd=optimizer)
            if iteration % 5 == 0:
                print(f"Итерация {iteration}, Потери: {losses.get('spancat', 0.0):.3f}")

    # Сохраняем модель (будет использовать spans_key, который есть в spancat.cfg)
    nlp.to_disk("./ruterm_finetuned_spancat")
    print("Модель сохранена в: ./ruterm_finetuned_spancat")
    return nlp

def pretty_predict_and_print(nlp, samples, max_show=3):
    print("\n=== Результаты инференса ===")
    for i, sample in enumerate(samples[:max_show]):
        print(f"\n--- Пример {i} ---")
        doc = nlp(sample["text"])
        # Выведем все ключи doc.spans (doc.spans поддерживает .keys() и итерирование)
        try:
            keys = list(doc.spans.keys())
        except Exception:
            try:
                keys = [k for k in doc.spans]
            except Exception:
                keys = []
        print("doc.spans keys:", keys)
        if keys:
            for k in keys:
                spans = doc.spans.get(k, [])
                print(f"spans under key '{k}': {len(spans)}")
                for s in spans:
                    print(f"  - '{s.text}' ({s.label_}) [{s.start_char}:{s.end_char}] tokens={len(s)}")
        else:
            print("doc.ents:", [(ent.text, ent.label_) for ent in doc.ents])
            print("Нет doc.spans ключей — возможно spancat не добавлял спаны или spans_key другой.")
        print("Ожидаемые термины (разметка):")
        for start, end, label in sample["label"][:20]:
            print(f"  - '{sample['text'][start:end]}' ({label}) [{start}:{end}]")

# ========== Основной поток ==========
data = load_data_from_github()
if data is None:
    raise SystemExit("Данные не загружены. Останов.")

train_data, test_data = train_test_split(data, test_size=0.2, random_state=42)
print(f"Тренировочные данные: {len(train_data)} документов")
print(f"Тестовые данные: {len(test_data)} документов")

# Используем spans_key по умолчанию "sc" (совпадает с конфигом, который вы видели)
spans_key = "sc"

train_docbin = convert_to_spacy_format(train_data, spans_key=spans_key)
test_docbin = convert_to_spacy_format(test_data, spans_key=spans_key)
train_docbin.to_disk("ruterm_train.spacy")
test_docbin.to_disk("ruterm_test.spacy")

# Дообучаем/подгоняем spancat (будет использовать существующий spans_key, если он есть)
model = train_with_transfer_learning(train_data, test_data, n_iter=30, desired_spans_key=spans_key)

# Загружаем дообученную модель и показываем предсказания (будут под ключом, указанным в spancat.cfg)
nlp = spacy.load("./ruterm_finetuned_spancat")
pretty_predict_and_print(nlp, test_data[:3])
